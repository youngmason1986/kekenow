<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/keke_green"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/passenger_waiting_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_green"/>
    </LinearLayout>

    <!-- Map -->
    <WebView
        android:id="@+id/wv_map_waiting"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface_white"
        android:elevation="8dp"
        android:gravity="center_horizontal">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/keke_green"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/passenger_waiting_body"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/card_fare_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fare_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/tv_waiting_fare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/keke_green"/>
        </LinearLayout>

        <!-- Accepted rider card (hidden until a rider accepts) -->
        <LinearLayout
            android:id="@+id/card_rider_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_green"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rider_card_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_green"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/iv_rider_photo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:contentDescription="@string/rider_card_title"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tv_rider_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_green"/>

                    <TextView
                        android:id="@+id/tv_rider_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_on_green"/>

                    <TextView
                        android:id="@+id/tv_rider_plate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_green"/>

                    <TextView
                        android:id="@+id/tv_rider_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_green"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rider_check_note"
                android:textSize="13sp"
                android:textColor="@color/text_on_green"
                android:alpha="0.85"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_call_rider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/rider_call"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_yellow"
                android:textColor="@color/text_on_yellow"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_cancel_wait"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/passenger_cancel"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_red"
            android:textColor="@color/text_on_green"/>
    </LinearLayout>
</LinearLayout>
