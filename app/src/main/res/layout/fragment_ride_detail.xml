<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/keke_yellow"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tv_detail_destination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_yellow"/>

        <TextView
            android:id="@+id/tv_detail_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textSize="12sp"
            android:textColor="@color/surface_white"
            android:background="@drawable/bg_status_badge"/>
    </LinearLayout>

    <!-- Map -->
    <WebView
        android:id="@+id/wv_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Map error -->
    <TextView
        android:id="@+id/tv_map_error"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/map_unavailable"
        android:textSize="16sp"
        android:textColor="@color/error_red"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- Info + action panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface_white"
        android:elevation="8dp">

        <!-- Distance & fare row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_distance"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_detail_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_fare"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_detail_fare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/keke_green"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/layout_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_decline_job"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/rider_decline"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_grey"
                android:textColor="@color/surface_white"/>

            <Button
                android:id="@+id/btn_accept_job"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:text="@string/rider_accept"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_green"
                android:textColor="@color/text_on_green"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_complete_job"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/rider_complete"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_yellow"
            android:textColor="@color/text_on_yellow"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
